# CouchDB server URL for remote data synchronization
# Must include the protocol and trailing slash
VITE_COUCH_URL=https://example.com/

# Auth0 authentication configuration
# Your Auth0 tenant domain
VITE_AUTH0_DOMAIN=example.eu.auth0.com

# Auth0 SPA application client ID
VITE_AUTH0_CLIENT_ID=your_client_id_here

# Auth0 API audience identifier
VITE_AUTH0_AUDIENCE=https://example.com
